# ================================================================
# /etc/systemd/system/kaspi-saas.service
# Установить: sudo cp deploy/kaspi-saas.service /etc/systemd/system/
# Активировать: sudo systemctl enable --now kaspi-saas
# ================================================================
[Unit]
Description=Kaspi SaaS Backend (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/kaspi-saas
EnvironmentFile=/opt/kaspi-saas/.env
ExecStart=/opt/kaspi-saas/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 5000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
